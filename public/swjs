/* Ndako POS – offline SW */
const SW_VERSION = 'ndako-offline-v1';
const OFFLINE_URL = '/offline.html';
const PRECACHE = [
  OFFLINE_URL,
  '/assets/images/logo/ndako.png', // optional brand logo used by offline.html
];

self.addEventListener('install', (event) => {
  event.waitUntil(
    caches.open(SW_VERSION)
      .then((cache) => cache.addAll(PRECACHE))
      .then(() => self.skipWaiting())
  );
});

self.addEventListener('activate', (event) => {
  event.waitUntil((async () => {
    const keys = await caches.keys();
    await Promise.all(
      keys.filter((k) => k !== SW_VERSION).map((k) => caches.delete(k))
    );
    await self.clients.claim();
  })());
});

/**
 * Navigation requests (full page loads) use Network-First with offline fallback.
 * This replaces the browser’s default “No Internet” page on refresh while offline.
 */
self.addEventListener('fetch', (event) => {
  const req = event.request;

  // Only handle navigations (HTML documents)
  const isNav = req.mode === 'navigate' ||
                (req.method === 'GET' && req.headers.get('accept')?.includes('text/html'));

  if (isNav) {
    event.respondWith((async () => {
      try {
        // Try network first
        const fresh = await fetch(req);
        // If server returns an error page, still fallback to offline
        if (!fresh || fresh.status >= 500) throw new Error('Server error');
        return fresh;
      } catch (err) {
        const cached = await caches.match(OFFLINE_URL);
        return cached || new Response('Offline', { status: 503, headers: { 'Content-Type': 'text/plain' } });
      }
    })());
    return;
  }

  // For other requests, pass-through (you can add more caching if you want)
  // Example: serve pre-cached logo if requested
  event.respondWith((async () => {
    const cached = await caches.match(req);
    return cached || fetch(req).catch(() => cached); // minimal resilience
  })());
});
